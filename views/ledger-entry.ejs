<%- include("partials/header") %>
<%
  const debits = entry.lines.reduce((s, l) => s + Number(l.debit), 0);
  const credits = entry.lines.reduce((s, l) => s + Number(l.credit), 0);
  const sourceLabel = {
    bookkeeping: "Bookkeeping entry", sale: "Sale", invoice_raised: "Invoice raised",
    bill_raised: "Bill received", manual: "Made by hand", adjustment: "Adjustment"
  };
%>

<section class="page-head">
  <h1>Entry #<%= entry.entry_no %></h1>
  <p class="muted">
    <%= formatDate(entry.entry_date) %> ·
    <%= sourceLabel[entry.source] || entry.source %>
    <% if (entry.source_id) { %>(source #<%= entry.source_id %>)<% } %> ·
    <a href="/business/<%= business.id %>/ledger" class="link">← general ledger</a>
  </p>
</section>

<section class="card">
  <h2 style="margin-top:0;"><%= entry.memo || "No memo" %></h2>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr><th>Code</th><th>Account</th><th>Type</th><th class="num">Debit</th><th class="num">Credit</th></tr>
      </thead>
      <tbody>
        <% entry.lines.forEach((l) => { %>
          <tr>
            <td class="muted"><%= l.code %></td>
            <td><%= l.name %><% if (l.memo) { %> <small class="muted">— <%= l.memo %></small><% } %></td>
            <td class="muted"><%= l.type %></td>
            <td class="num"><%= Number(l.debit) > 0 ? money(l.debit) : "—" %></td>
            <td class="num"><%= Number(l.credit) > 0 ? money(l.credit) : "—" %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="3">Total</th>
          <th class="num"><%= money(debits) %></th>
          <th class="num"><%= money(credits) %></th>
        </tr>
      </tfoot>
    </table>
  </div>
  <p class="muted" style="font-size:0.85rem;margin:0.8rem 0 0;">
    <% if (Math.abs(debits - credits) < 0.01) { %>
      Both sides come to <%= money(debits) %>, as every entry must.
    <% } else { %>
      <strong class="negative">This entry does not balance.</strong>
    <% } %>
  </p>
</section>

<%- include("partials/footer") %>
