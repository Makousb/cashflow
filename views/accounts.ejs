<%- include("partials/header") %>

<section class="page-head">
  <h1>Accounts</h1>
  <p class="muted">Your wallets — balances update as you record transactions.</p>
</section>

<div class="two-col">
  <section class="card">
    <h2>Add an account</h2>
    <form action="/accounts" method="POST" class="stacked-form">
      <label>
        Name
        <input type="text" name="name" required maxlength="80" placeholder="e.g. M-Pesa" />
      </label>
      <label>
        Type
        <select name="type">
          <% accountTypes.forEach((t) => { %>
            <option value="<%= t %>"><%= t.replace("_", " ") %></option>
          <% }) %>
        </select>
      </label>
      <button type="submit" class="btn btn-primary">Add account</button>
    </form>
  </section>

  <section class="card">
    <h2>Your wallets</h2>
    <% if (accounts.length === 0) { %>
      <p class="empty-state">No accounts yet — add your first wallet.</p>
    <% } else { %>
      <ul class="tx-list">
        <% accounts.forEach((a) => { %>
          <li class="tx-row">
            <span class="tx-icon">
              <%- icon({ cash: "wallet", bank: "bank", mobile_money: "phone", credit_card: "card" }[a.type] || "wallet") %>
            </span>
            <span class="tx-meta">
              <strong>
                <%= a.mono_account_id ? (a.institution_name || a.name) : a.name %>
                <% if (a.mono_account_id) { %>
                  <span class="badge badge-done">linked</span>
                <% } %>
              </strong>
              <small class="muted">
                <% if (a.mono_account_id) { %>
                  <%= a.account_number_mask || "bank" %><% if (a.mono_synced_at) { %> · synced <%= formatDate(a.mono_synced_at) %><% } %>
                <% } else { %>
                  <%= a.type.replace("_", " ") %>
                <% } %>
              </small>
            </span>
            <span class="tx-amount <%= Number(a.balance) >= 0 ? "positive" : "negative" %>">
              <%= money(a.balance) %>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<% if (accounts.length >= 2) { %>
  <section class="card" style="margin-top: 1.5rem;">
    <h2>Transfer between wallets</h2>
    <p class="muted" style="margin-top: -0.4rem;">
      Moving your own money doesn't count as spending or income — a
      transfer never shows up in your budgets or totals.
    </p>
    <form action="/transfers" method="POST" class="stacked-form">
      <label>
        From
        <select name="fromAccountId" required>
          <% accounts.forEach((a) => { %>
            <option value="<%= a.id %>"><%= a.mono_account_id ? (a.institution_name || a.name) : a.name %></option>
          <% }) %>
        </select>
      </label>
      <label>
        To
        <select name="toAccountId" required>
          <% accounts.forEach((a) => { %>
            <option value="<%= a.id %>"><%= a.mono_account_id ? (a.institution_name || a.name) : a.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Amount<input type="number" name="amount" step="0.01" min="0.01" required /></label>
      <label>
        Date
        <input type="date" name="occurredOn" value="<%= today %>" />
      </label>
      <label>Note (optional)<input type="text" name="note" maxlength="200" /></label>
      <button type="submit" class="btn btn-primary"><%- icon("swap") %> Transfer</button>
    </form>
  </section>
<% } %>

<% if (monoEnabled) { %>
  <section class="card" style="margin-top: 1.5rem;">
    <h2>Connect a bank</h2>
    <p class="muted" style="margin-top: -0.4rem;">
      Link a real bank account and Cashflow imports its transactions and
      keeps its balance current automatically — nothing to type by hand.
      Your bank login is entered on your bank/Mono's own page, never on
      Cashflow.
    </p>
    <form action="/accounts/mono/connect" method="POST" class="inline-form">
      <button type="submit" class="btn btn-primary">
        <%- icon("bank") %> Connect a bank account
      </button>
    </form>
  </section>
<% } %>

<%- include("partials/footer") %>
