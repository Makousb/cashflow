<%- include("partials/header") %>

<section class="page-head">
  <h1><%= business.name %> · Tax</h1>
  <p class="muted">
    Estimate what you owe and set it aside ·
    <a href="/business/<%= business.id %>" class="link">← business dashboard</a>
  </p>
</section>

<section class="stat-grid">
  <div class="card stat-card">
    <span class="stat-icon tint-red">🧾</span>
    <span class="stat-body">
      <span class="stat-label">Estimated tax owed</span>
      <span class="stat-value negative"><%= money(totalOwed) %></span>
    </span>
  </div>
  <div class="card stat-card">
    <span class="stat-icon">🏦</span>
    <span class="stat-body">
      <span class="stat-label">Set aside</span>
      <span class="stat-value positive"><%= money(setAside) %></span>
    </span>
  </div>
  <div class="card stat-card">
    <span class="stat-icon <%= remaining > 0 ? "tint-red" : "" %>">
      <%= remaining > 0 ? "⚠️" : "✅" %>
    </span>
    <span class="stat-body">
      <span class="stat-label"><%= remaining > 0 ? "Still to set aside" : "Fully covered" %></span>
      <span class="stat-value <%= remaining > 0 ? "negative" : "positive" %>">
        <%= money(Math.abs(remaining)) %>
      </span>
    </span>
  </div>
</section>

<section class="card" style="margin-bottom:1.5rem;">
  <div class="budget-row" style="margin-top:0;">
    <h2 style="margin:0;"><%= sales.rates.salesTax.label %> position</h2>
    <span class="badge badge-done">
      <%= sales.rates.name %> · <%= sales.rates.authority %>
    </span>
  </div>
  <% if (sales.rates.salesTax.varies) { %>
    <p class="muted">
      <%= sales.rates.name %> sets <%= sales.rates.salesTax.label.toLowerCase() %>
      locally rather than nationally, so there is no rate to apply here. Enter the
      one you charge on the <a href="/business/<%= business.id %>/group" class="link">group page</a>
      and this will work it out.
    </p>
  <% } %>
  <div class="stmt-line">
    <span><%= sales.rates.salesTax.label %> charged on sales (<%= sales.rates.salesTax.rate %>%)</span>
    <span><%= money(sales.output.tax) %></span>
  </div>
  <% if (sales.rates.salesTax.reclaimable) { %>
    <div class="stmt-line">
      <span>Less <%= sales.rates.salesTax.label %> you were charged</span>
      <span class="positive">(<%= money(sales.input.tax) %>)</span>
    </div>
  <% } %>
  <div class="stmt-line stmt-total">
    <span><%= sales.position.refundDue ? "Refund due to you" : `Owed to ${sales.rates.authority}` %></span>
    <span class="<%= sales.position.refundDue ? "positive" : "negative" %>">
      <%= money(sales.position.net) %>
    </span>
  </div>
  <p class="muted" style="font-size:0.85rem;margin:0.8rem 0 0;">
    <% if (sales.rates.salesTax.reclaimable) { %>
      You are a collector here, not a payer: you hand over what you charged less
      what you were charged.
      <%= sales.position.refundDue
        ? "You were charged more than you collected, so this is money owed back to you — worth claiming."
        : "" %>
    <% } else { %>
      <%= sales.rates.salesTax.label %> is charged to the final buyer and is not
      reclaimable, so all of what you collected is owed on.
    <% } %>
    Amounts here are recorded tax-inclusive, so the tax is taken back out of your
    totals rather than added up per line — an approximation, and a close one for
    a business on a single rate.
    <a href="/business/<%= business.id %>/group" class="link">Change where you trade →</a>
  </p>
</section>

<section class="card" style="margin-bottom:1.5rem;">
  <h2>How it's estimated</h2>
  <p class="muted">A rough estimate from your books — confirm with a tax professional before filing.</p>
  <div class="progress" style="height:12px;margin:0.75rem 0 1.25rem;">
    <div class="progress-fill goal" style="width: <%= Math.round(coverage) %>%"></div>
  </div>
  <ul class="tx-list">
    <li class="tx-row">
      <span class="tx-icon">📈</span>
      <span class="tx-meta">
        <strong>Income tax</strong>
        <small class="muted"><%= rate %>% of <%= money(taxableProfit) %> taxable profit
          (revenue <%= money(pnl.revenue) %> − expenses <%= money(pnl.expenses) %>)</small>
      </span>
      <span class="tx-amount negative"><%= money(incomeTax) %></span>
    </li>
    <li class="tx-row">
      <span class="tx-icon">👥</span>
      <span class="tx-meta">
        <strong>Payroll deductions to remit</strong>
        <small class="muted">PAYE and statutory amounts withheld from staff pay</small>
      </span>
      <span class="tx-amount negative"><%= money(payrollDeductions) %></span>
    </li>
    <li class="tx-row">
      <span class="tx-icon">🧮</span>
      <span class="tx-meta"><strong>Total estimated tax</strong></span>
      <span class="tx-amount negative"><%= money(totalOwed) %></span>
    </li>
  </ul>
</section>

<div class="two-col">
  <section class="card">
    <h2>Settings</h2>
    <form action="/business/<%= business.id %>/tax/settings" method="POST" class="stacked-form">
      <label>
        Income tax rate (%)
        <input type="number" name="rate" step="0.01" min="0" max="100" value="<%= rate %>" />
        <small class="muted">Applied to net profit. Default 30%.</small>
      </label>
      <button type="submit" class="btn btn-ghost">Save rate</button>
    </form>

    <h2 style="margin-top:1.5rem;">Set aside for tax</h2>
    <form action="/business/<%= business.id %>/tax/provisions" method="POST" class="stacked-form">
      <label>Amount<input type="number" name="amount" step="0.01" min="0.01" required /></label>
      <label>Date<input type="date" name="setOn" value="<%= today %>" /></label>
      <label>Note (optional)<input type="text" name="note" maxlength="200" placeholder="e.g. Q3 provision" /></label>
      <button type="submit" class="btn btn-primary">Set aside</button>
    </form>
  </section>

  <section class="card">
    <h2>Set-aside history</h2>
    <% if (provisions.length === 0) { %>
      <p class="empty-state">Nothing set aside yet. Reserve some of your profit so tax time isn't a surprise.</p>
    <% } else { %>
      <ul class="tx-list">
        <% provisions.forEach((p) => { %>
          <li class="tx-row">
            <span class="tx-icon">🏦</span>
            <span class="tx-meta">
              <strong><%= p.note || "Tax reserve" %></strong>
              <small class="muted"><%= formatDate(p.set_on) %></small>
            </span>
            <span class="tx-amount positive"><%= money(p.amount) %></span>
            <form action="/business/<%= business.id %>/tax/provisions/<%= p.id %>/delete" method="POST" class="inline-form">
              <button type="submit" class="btn btn-ghost btn-sm" title="Remove">✕</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include("partials/footer") %>
