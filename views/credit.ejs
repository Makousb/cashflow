<%- include("partials/header") %>

<section class="page-head">
  <h1>Credit</h1>
  <p class="muted">
    Short-term borrowing, purchase plans, and cards — from one secured by your
    own deposit up to three that have to be earned. Every answer is worked out
    from this ledger: what you earn, what you spend, and what you already owe here.
    <a href="/credit/agent" class="link">Let the card agent manage them →</a>
    <a href="/credit/report" class="link">Run your credit report for the year →</a>
    <a href="/credit/checks" class="link">Share it with a lender →</a>
  </p>
</section>

<section class="stat-grid">
  <div class="card stat-card">
    <span class="stat-icon"><%- icon("wallet") %></span>
    <span class="stat-body">
      <span class="stat-label">Spare each month</span>
      <span class="stat-value <%= means.disposable > 0 ? "positive" : "" %>"><%= money(means.disposable) %></span>
      <small class="muted">
        <%= money(means.income) %> in, <%= money(means.expenses) %> out,
        <%= money(means.commitments) %> already promised
      </small>
    </span>
  </div>
  <div class="card stat-card">
    <span class="stat-icon tint-red"><%- icon("document") %></span>
    <span class="stat-body">
      <span class="stat-label">Outstanding here</span>
      <span class="stat-value <%= owed > 0 ? "negative" : "" %>"><%= money(owed) %></span>
      <small class="muted"><%= active.length %> live</small>
    </span>
  </div>
  <div class="card stat-card">
    <span class="stat-icon"><%- icon("card") %></span>
    <span class="stat-body">
      <span class="stat-label">Card left to spend</span>
      <%
        // Across every card held, not whichever one comes back first: two cards
        // half used still leave half of both to spend.
        const held = active.filter((f) => cards[f.product]);
        const cardLimit = held.reduce((sum, f) => sum + f.card.limit, 0);
        const cardBalance = held.reduce((sum, f) => sum + f.card.balance, 0);
      %>
      <span class="stat-value"><%= held.length ? money(cardLimit - cardBalance) : "—" %></span>
      <small class="muted">
        <%= held.length
          ? `${money(cardBalance)} of ${money(cardLimit)} used across ${held.length} card${held.length === 1 ? "" : "s"}`
          : "no card open" %>
      </small>
    </span>
  </div>
</section>

<% if (means.income <= 0) { %>
  <section class="card">
    <p class="muted" style="margin:0;">
      Nothing has been recorded as income yet, so there is nothing here to lend
      against. <a href="/transactions" class="link">Record what you earn →</a>
    </p>
  </section>
<% } %>

<h2>Apply</h2>
<div class="two-col">
  <section class="card">
    <h3><%= products.day_loan.label %></h3>
    <p class="muted"><%= products.day_loan.blurb %></p>
    <form action="/credit/apply" method="POST" class="stacked-form">
      <input type="hidden" name="product" value="day_loan" />
      <label>
        How much
        <input type="number" name="amount" step="0.01" min="0.01" required />
        <small class="muted">Capped at half a month's income.</small>
      </label>
      <label>
        Repay in
        <select name="term">
          <% products.day_loan.terms.forEach((t) => { %>
            <option value="<%= t %>"><%= t %> days — fee <%= (t / 7).toFixed(0) %>% of the amount</option>
          <% }) %>
        </select>
      </label>
      <label>
        Pay into
        <select name="accountId">
          <% accounts.forEach((a) => { %>
            <option value="<%= a.id %>"><%= a.name %> (<%= money(a.balance) %>)</option>
          <% }) %>
        </select>
      </label>
      <label>
        What for (optional)
        <input type="text" name="purpose" maxlength="200" placeholder="e.g. Car repair" />
      </label>
      <button type="submit" class="btn btn-primary">Apply</button>
    </form>
  </section>

  <section class="card">
    <h3><%= products.bnpl.label %></h3>
    <p class="muted"><%= products.bnpl.blurb %></p>
    <form action="/credit/apply" method="POST" class="stacked-form">
      <input type="hidden" name="product" value="bnpl" />
      <label>
        Purchase amount
        <input type="number" name="amount" step="0.01" min="0.01" required />
        <small class="muted">Nothing leaves your wallet until an instalment falls due.</small>
      </label>
      <label>
        Split into
        <select name="term">
          <% products.bnpl.terms.forEach((t) => { %>
            <option value="<%= t %>"><%= t %> monthly payments</option>
          <% }) %>
        </select>
      </label>
      <label>
        What for (optional)
        <input type="text" name="purpose" maxlength="200" placeholder="e.g. Washing machine" />
      </label>
      <button type="submit" class="btn btn-primary">Apply</button>
    </form>
  </section>
</div>

<h2>Cards</h2>
<p class="muted" style="margin-top:-0.5rem;">
  Four grades. The secured one anyone can have, because the limit is your own
  deposit and there is nothing to judge. The three above it are earned here:
  paying on time is what buys a lower rate, a bigger limit, and faster points.
  <% if (standing.score.score !== null) { %>
    Your score is <strong><%= standing.score.score %></strong> on
    <strong><%= standing.historyMonths %></strong> month<%= standing.historyMonths === 1 ? "" : "s" %>
    of history, with <strong><%= standing.cleanMonths %></strong> clean.
  <% } %>
</p>

<% offers.forEach((offer) => { %>
  <%
    const mine = active.find((f) => f.product === offer.product);
    const earn = Object.entries(offer.earn.bonus)
      .sort((a, b) => b[1] - a[1])
      .map(([name, rate]) => `${rate}× on ${name.toLowerCase()}`);
  %>
  <section class="card">
    <div class="card-head">
      <h3 style="margin:0;">
        <%= offer.label %>
        <% if (mine) { %><span class="badge badge-done">held</span>
        <% } else if (offer.eligible) { %><span class="badge badge-warn">you qualify</span>
        <% } %>
      </h3>
      <span class="muted">
        <%= offer.apr %>% APR ·
        <%= offer.secured ? "limit = your deposit" : `limit up to ${money(offer.limit)}` %>
      </span>
    </div>
    <p class="muted"><%= offer.blurb %></p>
    <p class="muted" style="font-size:0.9rem;">
      Earns <%= offer.earn.base %> point<%= offer.earn.base === 1 ? "" : "s" %> per 100 spent<%
        %><% if (earn.length) { %>, and <%= earn.join(", ") %><% } %>.
      One point comes back as 1 off a balance.
      <% if (!offer.secured) { %>
        Needs a score of <%= offer.minScore %> and
        <%= offer.minHistoryMonths %> months of history.
      <% } %>
    </p>

    <% if (mine) { %>
      <p class="muted" style="margin:0;">
        You hold this one — see it below, or let the
        <a href="/credit/agent" class="link">card agent</a> manage it.
      </p>
    <% } else if (offer.secured) { %>
      <form action="/credit/apply" method="POST" class="stacked-form">
        <input type="hidden" name="product" value="secured_card" />
        <input type="hidden" name="term" value="0" />
        <label>
          Deposit
          <input type="number" name="amount" step="0.01" min="0.01" required />
          <small class="muted">
            Your limit is the same as your deposit. It leaves the wallet you choose
            and comes back when you close the card.
          </small>
        </label>
        <label>
          Take the deposit from
          <select name="accountId">
            <% accounts.forEach((a) => { %>
              <option value="<%= a.id %>"><%= a.name %> (<%= money(a.balance) %>)</option>
            <% }) %>
          </select>
        </label>
        <button type="submit" class="btn btn-primary">Apply</button>
      </form>
    <% } else if (offer.eligible) { %>
      <form action="/credit/apply" method="POST" class="inline-form">
        <input type="hidden" name="product" value="<%= offer.product %>" />
        <input type="hidden" name="term" value="0" />
        <button type="submit" class="btn btn-primary">
          Apply — no deposit, limit <%= money(offer.limit) %>
        </button>
      </form>
    <% } else { %>
      <p class="muted" style="margin:0;">
        <strong>Not yet.</strong> <%= offer.reason %>
      </p>
    <% } %>
  </section>
<% }) %>

<h2>What you hold</h2>
<% if (!facilities.length) { %>
  <section class="card">
    <p class="muted" style="margin:0;">Nothing yet. An approved application shows up here.</p>
  </section>
<% } else { %>
  <% facilities.forEach((f) => { %>
    <section class="card">
      <div class="card-head">
        <h3 style="margin:0;">
          <%= f.label %>
          <span class="badge <%= f.status === "active" ? "badge-warn" : "badge-done" %>"><%= f.status %></span>
          <% if (f.standing.isOverdue) { %><span class="badge badge-danger">overdue</span><% } %>
        </h3>
        <span class="muted"><%= products[f.product].label %> · opened <%= formatDate(f.opened_on) %></span>
      </div>

      <% if (cards[f.product]) { %>
        <p class="muted">
          Limit <strong><%= money(f.card.limit) %></strong><%
            %><% if (Number(f.deposit) > 0) { %>, secured by a
          <%= money(f.deposit) %> deposit<% } else { %>, unsecured<% } %>.
          <%= Number(f.apr).toFixed(0) %>% APR on anything carried past the month.
        </p>

        <p>
          <strong><%= money(f.card.balance) %></strong> owing ·
          <strong class="<%= f.card.available > 0 ? "positive" : "negative" %>"><%= money(f.card.available) %></strong>
          left to spend · <%= f.card.utilisation %>% of the limit used
        </p>
        <div class="progress" title="<%= f.card.utilisation %>% used">
          <span class="progress-fill" style="width: <%= f.card.utilisation %>%;"></span>
        </div>
        <% if (f.card.interestCharged > 0 || f.card.lateFeesCharged > 0) { %>
          <p class="muted">
            <%= money(f.card.interestCharged) %> of interest charged so far<%
              %><% if (f.card.lateFeesCharged > 0) { %>, and
            <%= money(f.card.lateFeesCharged) %> in late fees<% } %>.
            Carrying this balance costs <%= money(f.card.monthlyInterest) %> next month.
          </p>
        <% } else if (f.card.balance > 0) { %>
          <p class="muted">
            Clear it before the month ends and it costs nothing. Carried, it adds
            <%= money(f.card.monthlyInterest) %> next month.
          </p>
        <% } %>

        <% if (f.card.statement) { %>
          <div class="card <%= f.card.statement.missed ? "alert-critical" : "alert-warning" %>"
               style="margin: 0.75rem 0;">
            <p style="margin:0;">
              <strong>
                <%= f.card.statement.missed ? "Minimum payment missed" : "Minimum payment due" %>
              </strong>
              — <%= money(f.card.minimumDue) %>
              <%= f.card.statement.missed ? "was due" : "by" %>
              <%= formatDate(f.card.dueOn) %>,
              on the statement drawn <%= formatDate(f.card.statement.closedOn) %>
              for <%= money(f.card.statement.balance) %>.
            </p>
            <% if (f.card.statement.paidTowards > 0) { %>
              <p class="muted" style="margin:0.25rem 0 0;">
                <%= money(f.card.statement.paidTowards) %> put towards it so far.
              </p>
            <% } %>
            <% if (f.card.missedCount > 1) { %>
              <p class="muted" style="margin:0.25rem 0 0;">
                <%= f.card.missedCount %> statements have gone unpaid, and each
                added a fee of a tenth of what was short.
              </p>
            <% } %>
            <% if (f.status === "active") { %>
              <form action="/credit/<%= f.id %>/pay" method="POST" class="inline-form"
                    style="margin-top:0.5rem;">
                <input type="hidden" name="amount" value="<%= toDisplayNumber(f.card.minimumDue) %>" />
                <select name="accountId">
                  <% accounts.forEach((a) => { %>
                    <option value="<%= a.id %>">From <%= a.name %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn">Pay the minimum</button>
              </form>
            <% } %>
          </div>
        <% } else if (f.card.statements.length) { %>
          <p class="muted">
            Nothing outstanding on the last statement, drawn
            <%= formatDate(f.card.statements.at(-1).closedOn) %>.
          </p>
        <% } %>

        <% if (f.status === "active") { %>
          <div class="two-col">
            <form action="/credit/<%= f.id %>/charges" method="POST" class="stacked-form">
              <label>
                Spend on the card
                <input type="number" name="amount" step="0.01" min="0.01" required
                       placeholder="Amount" />
              </label>
              <label>
                What for
                <input type="text" name="merchant" maxlength="120" required
                       placeholder="e.g. Naivas" />
              </label>
              <label>
                Category
                <select name="categoryId">
                  <option value="">— none —</option>
                  <% spendCategories.forEach((c) => { %>
                    <option value="<%= c.id %>"><%= c.icon %> <%= c.name %></option>
                  <% }) %>
                </select>
                <small class="muted">
                  What earns the points: this card pays
                  <%= cards[f.product].earn.base %>× as standard<%
                    %><% const bonus = Object.entries(cards[f.product].earn.bonus); %><%
                    %><% if (bonus.length) { %>, and more on
                  <%= bonus.map(([n, r]) => `${n.toLowerCase()} (${r}×)`).join(", ") %><% } %>.
                </small>
              </label>
              <button type="submit" class="btn">Charge to the card</button>
            </form>

            <form action="/credit/<%= f.id %>/pay" method="POST" class="stacked-form">
              <label>
                Pay the card
                <input type="number" name="amount" step="0.01" min="0.01" required
                       value="<%= f.card.balance > 0 ? toDisplayNumber(f.card.balance) : "" %>" />
                <small class="muted">More than is owing is trimmed to what is owing.</small>
              </label>
              <label>
                From
                <select name="accountId">
                  <% accounts.forEach((a) => { %>
                    <option value="<%= a.id %>"><%= a.name %> (<%= money(a.balance) %>)</option>
                  <% }) %>
                </select>
              </label>
              <button type="submit" class="btn">Pay</button>
            </form>
          </div>

          <form action="/credit/<%= f.id %>/close" method="POST" class="inline-form">
            <select name="accountId">
              <% accounts.forEach((a) => { %>
                <option value="<%= a.id %>">Return to <%= a.name %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn">Close and get the deposit back</button>
          </form>
        <% } %>

        <% if (f.charges.length) { %>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr><th>Date</th><th>What</th><th>Category</th><th class="num">Amount</th></tr>
              </thead>
              <tbody>
                <% f.charges.forEach((c) => { %>
                  <tr>
                    <td><%= formatDate(c.charged_on) %></td>
                    <td><%= c.merchant %></td>
                    <td class="muted">
                      <%= c.category ? `${c.category_icon} ${c.category}` : "—" %>
                    </td>
                    <td class="num"><%= money(c.amount) %></td>
                  </tr>
                <% }) %>
                <% f.cardPayments.forEach((p) => { %>
                  <tr>
                    <td><%= formatDate(p.paid_on) %></td>
                    <td class="muted">
                      <%= p.source === "points" ? "Points redeemed"
                        : p.source === "agent" ? "Payment by the card agent" : "Payment" %>
                    </td>
                    <td class="muted">—</td>
                    <td class="num positive">−<%= money(p.amount) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (f.card.statements.length) { %>
          <h4>Statements</h4>
          <div class="table-scroll">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Drawn</th><th class="num">Balance</th><th class="num">Interest</th>
                  <th class="num">Minimum</th><th>Due</th><th>Status</th><th class="num">Fee</th>
                </tr>
              </thead>
              <tbody>
                <% [...f.card.statements].reverse().forEach((s) => { %>
                  <tr>
                    <td><%= formatDate(s.closedOn) %></td>
                    <td class="num"><%= money(s.balance) %></td>
                    <td class="num"><%= money(s.interest) %></td>
                    <td class="num"><%= money(s.minimumDue) %></td>
                    <td><%= formatDate(s.dueOn) %></td>
                    <td>
                      <% if (s.met) { %>
                        <span class="badge badge-done">met</span>
                      <% } else if (s.missed) { %>
                        <span class="badge badge-danger">missed</span>
                      <% } else { %>
                        <span class="badge badge-warn">due</span>
                      <% } %>
                    </td>
                    <td class="num"><%= s.lateFee > 0 ? money(s.lateFee) : "—" %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      <% } else { %>
        <p class="muted">
          <%= money(f.principal) %> borrowed<% if (Number(f.fee) > 0) { %>,
          <%= money(f.fee) %> fee<% } %> ·
          <strong><%= money(f.standing.outstanding) %></strong> still to pay
          <% if (f.standing.paid > 0) { %>· <%= money(f.standing.paid) %> paid<% } %>
        </p>

        <div class="table-scroll">
          <table class="data-table">
          <thead>
            <tr><th>#</th><th>Due</th><th>Amount</th><th>Status</th><th></th></tr>
          </thead>
          <tbody>
            <% f.installments.forEach((i) => { %>
              <tr>
                <td><%= i.sequence %></td>
                <td><%= formatDate(i.due_on) %></td>
                <td><%= money(i.amount) %></td>
                <td>
                  <% if (i.paid_on) { %>
                    <span class="badge badge-done">paid <%= formatDate(i.paid_on) %></span>
                  <% } else if (i.due_on < today) { %>
                    <span class="badge badge-danger">overdue</span>
                  <% } else { %>
                    <span class="badge badge-warn">due</span>
                  <% } %>
                </td>
                <td>
                  <% if (!i.paid_on) { %>
                    <form action="/credit/installments/<%= i.id %>/pay" method="POST" class="inline-form">
                      <select name="accountId">
                        <% accounts.forEach((a) => { %>
                          <option value="<%= a.id %>"><%= a.name %></option>
                        <% }) %>
                      </select>
                      <button type="submit" class="btn">Pay</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      <% } %>
    </section>
  <% }) %>
<% } %>

<% if (applications.length) { %>
  <h2>Decisions</h2>
  <section class="card">
    <div class="table-scroll">
          <table class="data-table">
      <thead>
        <tr><th>Applied for</th><th>Amount</th><th>Answer</th><th>Why</th><th>When</th></tr>
      </thead>
      <tbody>
        <% applications.forEach((a) => { %>
          <tr>
            <td><%= products[a.product].label %></td>
            <td><%= money(a.amount) %></td>
            <td>
              <span class="badge <%= a.status === "approved" ? "badge-done" : "badge-danger" %>">
                <%= a.status %>
              </span>
            </td>
            <td class="muted"><%= a.reason %></td>
            <td class="muted"><%= formatDate(a.decided_on) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
        </div>
  </section>
<% } %>

<%- include("partials/footer") %>
