<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Cashflow</title>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />
  <link rel="apple-touch-icon" href="/img/logo.svg" />
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
  <% const navClass = (href) => (currentPath === href || (href !== "/" && currentPath.startsWith(href)) ? "active" : ""); %>
  <% if (currentUser) { %>
    <div class="app-shell">
      <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
      <aside class="sidebar" id="app-sidebar">
        <a class="brand" href="/">
          <img src="/img/logo.svg" alt="" class="brand-mark" width="30" height="30" />
          Cashflow
        </a>
        <nav class="sidebar-nav">
          <a href="/dashboard" class="<%= navClass("/dashboard") %>"><%- icon("home") %><span>Dashboard</span></a>
          <a href="/transactions" class="<%= navClass("/transactions") %>"><%- icon("document") %><span>Transactions</span></a>
          <a href="/recurring" class="<%= navClass("/recurring") %>"><%- icon("refresh") %><span>Recurring</span></a>
          <a href="/receipts" class="<%= navClass("/receipts") %>"><%- icon("receipt") %><span>Receipts</span></a>
          <a href="/budgets" class="<%= navClass("/budgets") %>"><%- icon("barChart") %><span>Budgets</span></a>
          <a href="/goals" class="<%= navClass("/goals") %>"><%- icon("target") %><span>Goals</span></a>
          <a href="/loans" class="<%= navClass("/loans") %>"><%- icon("bank") %><span>Loans</span></a>
          <a href="/credit" class="<%= navClass("/credit") %>"><%- icon("card") %><span>Credit</span></a>
          <a href="/reports" class="<%= navClass("/reports") %>"><%- icon("trendingUp") %><span>Reports</span></a>
          <a href="/accounts" class="<%= navClass("/accounts") %>"><%- icon("wallet") %><span>Accounts</span></a>
          <% if (showBusinessNav || showSupplierNav) { %>
            <div class="sidebar-divider"></div>
          <% } %>
          <% if (showBusinessNav) { %>
            <a href="/business" class="<%= navClass("/business") %>"><%- icon("storefront") %><span>Business</span></a>
          <% } %>
          <% if (showSupplierNav) { %>
            <a href="/supplier" class="<%= navClass("/supplier") %>"><%- icon("factory") %><span>Supplier</span></a>
          <% } %>
        </nav>
        <div class="sidebar-footer">
          <a href="/settings" class="<%= navClass("/settings") %>"><%- icon("gear") %><span>Settings</span></a>
          <form action="/auth/logout" method="POST" class="inline-form">
            <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
          </form>
        </div>
      </aside>
      <div class="mobile-topbar">
        <button
          type="button"
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="app-sidebar"
          aria-label="Open menu"
        ><%- icon("menu") %></button>
        <a class="brand" href="/">
          <img src="/img/logo.svg" alt="" class="brand-mark" width="26" height="26" />
          Cashflow
        </a>
      </div>
      <div class="app-content">
  <% } else { %>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/img/logo.svg" alt="" class="brand-mark" width="30" height="30" />
        Cashflow
      </a>
      <nav class="site-nav">
        <a href="/auth/login" class="<%= navClass("/auth/login") %>">Log in</a>
        <a href="/auth/register" class="btn btn-primary">Sign up</a>
      </nav>
    </header>
  <% } %>

  <% if (!dbReady) { %>
    <div class="flash flash-warn">
      Running without a database — nothing will be saved. Copy .env.example to .env and point it at PostgreSQL.
    </div>
  <% } %>
  <% if (success && success.length) { %>
    <div class="flash flash-success"><%= success[0] %></div>
  <% } %>
  <% if (typeof warn !== "undefined" && warn && warn.length) { %>
    <div class="flash flash-warn"><%= warn[0] %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="flash flash-error"><%= error[0] %></div>
  <% } %>

  <main class="container">
