# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
# 3001 by default so it can run next to other local apps on 3000.
PORT=3001
# Required in production; any random long string works in development.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Analytics service (Python/FastAPI) ---
# The Node app calls this for the Reports page. If the service is down,
# Reports degrades gracefully and the rest of the app is unaffected.
ANALYTICS_URL=http://localhost:8000

# --- Business advisor (optional) ---
# Point these at any standard chat-completions API to enable conversational
# answers in the business advisor. Leave blank to use the built-in insights.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- PostgreSQL ---
# Hosted platforms (Render/Heroku/Railway) can supply a single DATABASE_URL
# instead of the discrete DB_* values below; it takes precedence when set.
# DATABASE_URL=postgres://user:password@host:5432/cashflow
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cashflow
DB_SSL=false

# --- Outgoing mail (optional) ---
# Without SMTP_HOST nothing is ever sent: the monthly accounting close still
# runs and simply records that it notified nobody. Any provider that speaks
# SMTP works — Gmail, Resend, Postmark, Mailgun, your own server.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false          # true for port 465 (implicit TLS)
# MAIL_FROM=Cashflow <no-reply@yourdomain.com>

# Used to build links back into the app from an email. Falls back to localhost.
# APP_URL=https://cashflow.example.com
